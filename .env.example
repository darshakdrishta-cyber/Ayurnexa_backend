# Copy this file to .env for local development; replace every placeholder.
# Never commit the real .env file.

# Application server (Railway supplies PORT automatically)
PORT=8080

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Generate independently with: openssl rand -base64 32
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MS=3600000

# Application request key. Generate a different random value, e.g. openssl rand -hex 32
API_KEY=replace-with-a-long-random-api-key
CORS_ALLOWED_ORIGINS=*

# PayU Payment Links OAuth credentials (server-side only)
PAYU_CLIENT_ID=<payu-client-id>
PAYU_CLIENT_SECRET=<payu-client-secret>
PAYU_MERCHANT_ID=<payu-merchant-id>
# Use "uat" for testing or "production" for live payments.
PAYU_ENVIRONMENT=uat

# Supabase Storage (image uploads)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon-public-key>
SUPABASE_SECRET_KEY=<service-role-secret-key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_S3_ACCESS_KEY_ID=<s3-access-key-id>
SUPABASE_S3_SECRET_ACCESS_KEY=<s3-secret-access-key>
SUPABASE_S3_REGION=<project-storage-region>
# Optional override; by default the backend uses ${SUPABASE_URL}/storage/v1/s3
# SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password-or-app-password>
MAIL_FROM=<from-email-address>
