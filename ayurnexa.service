[Unit]
Description=Spring Boot Ayurnexa API Service
After=network.target

[Service]
User=root
WorkingDirectory=/opt/Ayurnexa_backend
ExecStart=/usr/bin/java -jar /opt/Ayurnexa_backend/target/Ayurnexa-0.0.1-SNAPSHOT.jar
SuccessExitStatus=143
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
