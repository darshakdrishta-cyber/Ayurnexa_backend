[Unit]
Description=Ayurnexa Backend (Docker)
After=docker.service
Requires=docker.service

[Service]
Restart=always
RestartSec=10
ExecStartPre=/usr/bin/docker pull ghcr.io/YOUR_GITHUB_USER/backendayurnexa:latest
ExecStart=/usr/bin/docker run --rm --name backendayurnexa -p 8080:8080 --env-file /opt/backendayurnexa/.env ghcr.io/YOUR_GITHUB_USER/backendayurnexa:latest
ExecStop=/usr/bin/docker stop backendayurnexa

[Install]
WantedBy=multi-user.target
